# ═══════════════════════════════════════════════════════════════════════════════
#  St. Cecilia's Greater Hope Foundations — environment template
# ═══════════════════════════════════════════════════════════════════════════════
#
#  This file is COMMITTED. The real .env is NOT — see docs/ENVIRONMENT.md.
#  Every key the application reads must appear here with a safe placeholder.
#  Never put a real secret in this file.
#
#  Legend for where each value comes from:
#    [cPanel]    cPanel at greaterhopefoundations.com/cpanel  (account: presti98)
#    [Paystack]  dashboard.paystack.com → Settings → API Keys & Webhooks
#    [SMS]       Arkesel / Hubtel / mNotify dashboard
#    [Generated] produced by an artisan command
#    [Decide]    a project decision, not fetched from anywhere
#    [Later]     placeholdered for now — see PHASE-1-BLUEPRINT.md §11.6
# ═══════════════════════════════════════════════════════════════════════════════


# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="St. Cecilia's Greater Hope Foundations"     # [Decide] {{LEGAL_NAME}}
APP_ENV=local                                          # local | staging | production
APP_KEY=                                               # [Generated] php artisan key:generate
APP_DEBUG=true                                         # MUST be false in staging + production
APP_URL=http://localhost                               # prod: https://greaterhopefoundations.com
APP_TIMEZONE=Africa/Accra                              # Ghana — GMT, no DST
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file

# Human-readable build marker, set by CI at deploy time. Shown in the admin footer.
APP_RELEASE=local


# ─── Logging ──────────────────────────────────────────────────────────────────
# 'daily' not 'single': shared hosting has a disk quota and an inode budget.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=debug                                        # production: warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null


# ─── Database ─────────────────────────────────────────────────────────────────
# [cPanel] Databases → Database Wizard. cPanel prefixes everything with the
# account username, so the names below are already correct for account presti98.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                                      # server: localhost
DB_PORT=3306
DB_DATABASE=presti98_scghf_prod                        # staging: presti98_scghf_stage
DB_USERNAME=presti98_scghf                             # staging: presti98_scghfstg
DB_PASSWORD=                                           # [cPanel] generated in Database Wizard
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci


# ─── Session / cache / queue ──────────────────────────────────────────────────
# All 'database': InMotion shared hosting has no Redis and no Memcached.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false                            # true in staging + production
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

CACHE_STORE=database
CACHE_PREFIX=scghf

QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
# Seconds a job may run. Kept under the cron worker's --max-time so nothing is
# killed mid-flight by the 60-second cron boundary.
QUEUE_RETRY_AFTER=90


# ─── Filesystem & media ───────────────────────────────────────────────────────
# 'public' = storage/app/public, exposed via the storage:link symlink.
# Switching to object storage later (risk SH-6, inode exhaustion) is a change to
# this one value plus the disk credentials — no application code changes.
FILESYSTEM_DISK=public
MEDIA_DISK=public
MEDIA_MAX_UPLOAD_MB=12
MEDIA_STRIP_EXIF=true                                  # GPS in beneficiary photos — never optional

# Optional object-storage escape hatch (Cloudflare R2 / Backblaze B2, S3-compatible)
S3_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true


# ─── Mail ─────────────────────────────────────────────────────────────────────
# Transactional mail (receipts, order updates) should NOT go through the shared
# cPanel IP — see PHASE-1-BLUEPRINT.md risk DEL-3. Provider chosen in §12c #14.
MAIL_MAILER=log                                        # local: log | prod: smtp or resend
MAIL_HOST=mail.greaterhopefoundations.com              # [cPanel] Email Accounts → Connect Devices
MAIL_PORT=465
MAIL_USERNAME=                                         # [cPanel] full mailbox address
MAIL_PASSWORD=                                         # [cPanel] mailbox password
MAIL_ENCRYPTION=ssl                                    # 465 = ssl, 587 = tls
MAIL_FROM_ADDRESS="noreply@greaterhopefoundations.com" # {{EMAIL_NOREPLY}}
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="info@greaterhopefoundations.com" # {{EMAIL_GENERAL}}

# Bulk/newsletter sending is throttled so cPanel/MailChannels hourly limits are
# never breached in one burst (risk DEL-2). Tune once InMotion confirms the cap.
MAIL_BULK_PER_MINUTE=20
MAIL_BULK_PER_HOUR=200

MAIL_ENABLED=true                                      # false still RENDERS and LOGS every message, sends none

# If a transactional provider is used instead of cPanel SMTP:
RESEND_API_KEY=
POSTMARK_TOKEN=
BREVO_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SECRET=


# ─── SMS ──────────────────────────────────────────────────────────────────────
# [Later] Provider not chosen, sender ID not registered. Driver-agnostic by design:
# 'log' writes every message to sms_logs exactly as if sent, but sends nothing.
# Switching provider later is this one line. See PHASE-1-BLUEPRINT.md §11.6.3.
SMS_DRIVER=log                                         # log | arkesel | hubtel | mnotify
SMS_SENDER_ID=GreaterHOPE                              # [SMS] MUST be registered or Ghanaian networks drop it silently
SMS_ENABLED=true
SMS_MONTHLY_BUDGET_GHS=200                             # alert threshold, not a hard stop
SMS_LOW_BALANCE_THRESHOLD=50

SMS_PER_MINUTE=60
SMS_PER_HOUR=1000
SMS_COST_PER_SEGMENT_MINOR=4                           # PESEWAS per segment; replace with the contracted rate
SMS_MAX_SEGMENTS=2                                     # a longer template is REFUSED — 3 segments is 3x the cost


# ─── Communications ───────────────────────────────────────────────────────────
# How many messages one cron invocation drains. The queue worker runs with
# --max-time=55, so this must finish comfortably inside a minute.
COMMS_BATCH_SIZE=25

# Open and click tracking are OFF, on purpose. Recording that a named person
# read a message, when, is Act 843 processing that needs its own lawful basis
# and its own line in the privacy notice — a decision for the trustees, not a
# default somebody inherits.
COMMS_TRACK_OPENS=false
COMMS_TRACK_CLICKS=false

ARKESEL_API_KEY=
ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2

HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_BASE_URL=https://smsc.hubtel.com/v1

MNOTIFY_API_KEY=
MNOTIFY_BASE_URL=https://api.mnotify.com/api


# ─── Payments — Paystack ──────────────────────────────────────────────────────
# [Later] Merchant account not open yet. PAYMENT_DRIVER=fake returns deterministic
# fixtures so the whole payments module is built and tested without credentials.
# See PHASE-1-BLUEPRINT.md §11.6.2. Production refuses to boot with 'fake'.
PAYMENT_DRIVER=fake                                    # fake | paystack

PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx    # [Paystack]
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx    # [Paystack] NEVER commit a real one
PAYSTACK_WEBHOOK_SECRET=                               # [Paystack] blank = use the secret key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=GHS                                  # never change — every call sends this
PAYSTACK_CALLBACK_URL="${APP_URL}/donate/callback"
PAYSTACK_WEBHOOK_PATH=/webhooks/paystack
PAYSTACK_TIMEOUT=20
PAYSTACK_CHANNELS="mobile_money,card"                  # MoMo first — it is how Ghana pays

# Money handling. Amounts are integer pesewas everywhere; these are display/policy.
CURRENCY_CODE=GHS
CURRENCY_SYMBOL="GH₵"
DONATION_MIN_PESEWAS=500                               # GH₵ 5.00
DONATION_MAX_PESEWAS=10000000                          # GH₵ 100,000.00
DONATION_PRESETS_PESEWAS="5000,10000,25000,50000,100000"
DONATION_ALLOW_FEE_COVER=true
# Paystack Ghana pricing — verify against your signed merchant agreement before go-live.
PAYSTACK_FEE_PERCENT=1.95
PAYSTACK_FEE_CAP_PESEWAS=10000                         # GH₵ 100.00 cap


# ─── Security ─────────────────────────────────────────────────────────────────
HONEYPOT_ENABLED=true
HONEYPOT_FIELD_NAME=scghf_hp
HONEYPOT_VALID_FROM_FIELD=scghf_vf
HONEYPOT_SECONDS=2
HONEYPOT_RANDOMIZE=true

ADMIN_PATH=admin                                       # [Decide] change to obscure the panel
ADMIN_2FA_REQUIRED=true                                # every admin role — not optional
ADMIN_SESSION_TIMEOUT=60

RATE_LIMIT_LOGIN=5
RATE_LIMIT_CONTACT=3
RATE_LIMIT_DONATION=10
RATE_LIMIT_API=60

FORCE_HTTPS=false                                      # true in staging + production


# ─── Backups ──────────────────────────────────────────────────────────────────
# A backup on the same shared account is not a backup. Ship it off-server.
BACKUP_ENABLED=true
BACKUP_DISK=local                                      # prod: s3 (R2/B2) or google
BACKUP_ARCHIVE_PASSWORD=                               # encrypts the archive — donor data
BACKUP_NOTIFICATION_EMAIL=                             # {{EMAIL_GENERAL}}
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_KEEP_LOCAL_COPIES=1                             # cPanel Backup Usage is capped at 10 GB


# ─── SEO, analytics & indexing ────────────────────────────────────────────────
# Staging must never be indexed. This drives robots.txt AND the X-Robots-Tag header.
ALLOW_SEARCH_INDEXING=false                            # true ONLY in production
SITE_ANALYTICS_ENABLED=false
SITE_ANALYTICS_PROVIDER=                               # plausible | umami | ga4 | (blank)
SITE_ANALYTICS_ID=
SITEMAP_ENABLED=true


# ─── Feature flags ────────────────────────────────────────────────────────────
# Modules deferred in PHASE-1-BLUEPRINT.md §12c ship behind flags, off by default,
# so partially-built features can never leak into production.
FEATURE_SHOP=true
FEATURE_DONATIONS=true
FEATURE_RECURRING_GIVING=true
FEATURE_MOBILE_MONEY=true
FEATURE_VOLUNTEERS=true
FEATURE_EVENTS=true
FEATURE_EVENT_TICKETING=false                          # deferred — §12c #12
FEATURE_P2P_FUNDRAISING=false                          # deferred — §12c #11
FEATURE_SPONSORSHIP=true
FEATURE_BLOG_COMMENTS=false
FEATURE_PRAYER_REQUESTS=true
FEATURE_MULTILINGUAL=false                             # scaffolding built, English at launch
FEATURE_SITE_SEARCH=false                              # post-launch — §3.2
FEATURE_DARK_MODE=true
FEATURE_PWA_OFFLINE=true


# ─── Frontend build (Vite) ────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_ALLOW_INDEXING="${ALLOW_SEARCH_INDEXING}"
